# 프론트 환경변수 (마스터설계 §3-2). frontend/.env.local 로 복사해 채운다.
# 실제 .env.local 은 gitignore — 커밋 금지.
# 연결 환경·테스트 계정·쓰기 범위 확인 전에는 prototype을 유지한다.
# NEXT_PUBLIC_* 값은 빌드에 포함되므로 변경 후 재빌드해야 한다.
NEXT_PUBLIC_DATA_MODE=prototype

# Supabase (브라우저는 anon key + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 새 프로젝트의 프론트용 키도 지원한다. 설정하면 ANON_KEY보다 우선한다.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Seam A Python 백엔드 (하이브리드 챗) 접점 — C 가 배포 후 확정
NEXT_PUBLIC_API_BASE=http://localhost:8000
# 실제 연결 시 DATA_MODE=live와 함께 사용한다. prototype에서는 외부 호출하지 않는다.
# NEXT_PUBLIC_CHAT_MODE=remote
# 연결 절차와 보류 항목: ../design/live-integration-readiness.md

# 데이터 모드 — 미지정이면 프로토타입(샘플 데이터·백엔드 미연결)이 기본값이다.
# 프로덕션(Vercel)과 실제 서버 연결 로컬 개발은 반드시 live. 빌드 시점에 박히므로 바꾸면 재빌드.
NEXT_PUBLIC_DATA_MODE=live
# 챗 기본 모드(옛 챗 화면용). 프로덕션은 remote.
NEXT_PUBLIC_CHAT_MODE=remote
